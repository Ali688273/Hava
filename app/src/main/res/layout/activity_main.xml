<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1128"
    android:padding="16dp">

    <!-- نوار جستجو، دکمه جستجو و دکمه GPS -->
    <LinearLayout
        android:id="@+id/searchLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etSearchCity"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="#1C2541"
            android:hint="نام شهر (تهران، مشهد...)"
            android:textColor="#FFFFFF"
            android:textColorHint="#8D99AE"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#3A506B"
            android:text="جستجو"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnGps"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#1C2541"
            android:text="📍"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCityName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchLayout"
        android:layout_centerHorizontal="true"
        android:text="تهران"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- پیش‌بینی ساعتی افقی زنده -->
    <HorizontalScrollView
        android:id="@+id/hourlyScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvCityName"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- کارت ساعت اول -->
            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="90dp"
                android:background="#1C2541"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:padding="8dp">
                <TextView android:id="@+id/tvHourlyTime1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اکنون" android:textColor="#B0BEC5" android:textSize="12sp"/>
                <ImageView android:id="@+id/ivHourlyIcon1" android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_day" android:layout_marginVertical="4dp"/>
                <TextView android:id="@+id/tvHourlyTemp1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- کارت ساعت دوم -->
            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="90dp"
                android:background="#1C2541"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:padding="8dp">
                <TextView android:id="@+id/tvHourlyTime2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+1" android:textColor="#B0BEC5" android:textSize="12sp"/>
                <ImageView android:id="@+id/ivHourlyIcon2" android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_day" android:layout_marginVertical="4dp"/>
                <TextView android:id="@+id/tvHourlyTemp2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- کارت ساعت سوم -->
            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="90dp"
                android:background="#1C2541"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:padding="8dp">
                <TextView android:id="@+id/tvHourlyTime3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+2" android:textColor="#B0BEC5" android:textSize="12sp"/>
                <ImageView android:id="@+id/ivHourlyIcon3" android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_day" android:layout_marginVertical="4dp"/>
                <TextView android:id="@+id/tvHourlyTemp3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- کارت ساعت چهارم -->
            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="90dp"
                android:background="#1C2541"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:padding="8dp">
                <TextView android:id="@+id/tvHourlyTime4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+3" android:textColor="#B0BEC5" android:textSize="12sp"/>
                <ImageView android:id="@+id/ivHourlyIcon4" android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_day" android:layout_marginVertical="4dp"/>
                <TextView android:id="@+id/tvHourlyTemp4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- کارت اطلاعات مرکزی و دمای بزرگ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/hourlyScroll"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#1C2541"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23°C"
                android:textColor="#FFFFFF"
                android:textSize="52sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvTemp"
                android:text="آسمان صاف"
                android:textColor="#B0BEC5"
                android:textSize="16sp" />

            <!-- آیکون وضعیت جوی اصلی در کارت دما -->
            <ImageView
                android:id="@+id/ivMainConditionIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:src="@android:drawable/ic_menu_day" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/ivMainConditionIcon"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWindSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="باد: 5 km/h"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvHumidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="رطوبت: 16%"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvPressure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="فشار: 1012 hPa"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- کارت پیش‌بینی چندروزه و جزئیات بارش -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardMain"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1C2541"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="پیش‌بینی روزهای آینده"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:id="@+id/tvDay1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="فردا: --°"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDay2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="پس‌فردا: --°"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDay3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="روز سوم: --°"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRainfall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="میزان بارندگی: 0.0 میلی‌متر"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvDataSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="پیش‌بینی از MET Norway"
                android:textColor="#8D99AE"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
